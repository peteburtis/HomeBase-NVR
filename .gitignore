# macOS and per-user Xcode state
.DS_Store
*.xcuserstate
xcuserdata/

# Build and test products (keep shared schemes and Package.resolved tracked)
build/
DerivedData/
.build/
*.xcresult/
*.xcarchive/

# Python test caches
__pycache__/
*.py[cod]
.venv/

# Local environment configuration (keep shareable templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Signing credentials and provisioning profiles
*.p12
*.pfx
*.pem
*.key
*.p8
*.mobileprovision
*.provisionprofile
